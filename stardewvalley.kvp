App.DisplayName=Stardew Valley
App.RootDir=./413150/
App.WorkingDir=./413150/
App.ExecutableLinux=./413150/StardewModdingAPI
App.ExecutableWin=./413150/StardewModdingAPI.exe
App.Compatibility=1
App.CommandLineArgs=--server --no-terminal {{$FormattedArgs}}
App.CommandLineParameterFormat=--{0} "{1}"
App.AppSettings={"FarmName": "AMP Farm", "ServerName": "Stardew Server"}
App.EnvironmentVariables={"DOTNET_ROLL_FORWARD": "Major", "DOTNET_TieredCompilation": "0"}
App.ExitMethod=String
App.ExitString=exit
App.HasWriteableConsole=True
App.HasReadableConsole=True
App.ApplicationIPBinding=0.0.0.0
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationPort1=24642
App.MaxUsers=8
App.AdminMethod=STDIO
App.UpdateSources=[{"UpdateStageName":"Download Stardew Valley via Steam","UpdateSourcePlatform":"All","UpdateSource":"SteamCMD","UpdateSourceData":"413150"},{"UpdateStageName":"Fetch SMAPI for Linux","UpdateSourcePlatform":"Linux","UpdateSource":"GithubRelease","UpdateSourceArgs":"Pathoschild/SMAPI","UpdateSourceData":"SMAPI-{version}-installer.zip","UnzipUpdateSource":true,"OverwriteExistingFiles":true,"SkipOnFailure":false},{"UpdateStageName":"Fetch SMAPI for Windows","UpdateSourcePlatform":"Windows","UpdateSource":"GithubRelease","UpdateSourceArgs":"Pathoschild/SMAPI","UpdateSourceData":"SMAPI-{version}-installer.zip","UnzipUpdateSource":true,"OverwriteExistingFiles":true,"SkipOnFailure":false},{"UpdateStageName":"Fetch SMAPI Dedicated Server Mod","UpdateSourcePlatform":"All","UpdateSource":"GithubRelease","UpdateSourceArgs":"ObjectManagerManager/SMAPIDedicatedServerMod","UpdateSourceData":"SMAPIDedicatedServerMod.zip","UpdateSourceTarget":"./413150/Mods/","UnzipUpdateSource":true,"OverwriteExistingFiles":true,"SkipOnFailure":false},{"UpdateStageName":"Mark SMAPI executable on Linux","UpdateSourcePlatform":"Linux","UpdateSource":"SetExecutableFlag","UpdateSourceArgs":"./413150/StardewModdingAPI"}]
App.SteamUpdateAnonymousLogin=False
App.SteamForceLoginPrompt=True
App.SteamForceWindowsVersion=False
App.RapidStartup=False

Console.AppReadyRegex=^.*?(?:Type 'help' for help|server is now listening|StardewModdingAPI v.*started).*$
Console.UserJoinRegex=^.*?(?<username>.+?) (?:has joined|connected to the server)\.?$
Console.UserLeaveRegex=^.*?(?<username>.+?) (?:has left|disconnected)\.?$
Console.UserChatRegex=^<(?<username>.+?)> (?<message>.+)$
Console.ThrowawayMessageRegex=^\s*$
Console.MetricsRegex=
Console.ServerInfoRegex=^.*?invite code:\s*(?<invite_code>\S+).*$

